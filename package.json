{
  "name": "tab-headers",
  "version": "0.1.0",
  "private": true,
  "description": "Chrome extension: per-tab custom request headers for testing",
  "license": "MIT",
  "homepage": "https://github.com/orshih6/tab-headers",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/orshih6/tab-headers.git"
  },
  "bugs": "https://github.com/orshih6/tab-headers/issues",
  "type": "module",
  "scripts": {
    "build": "tsc --noEmit && node build.mjs",
    "dev": "node build.mjs --watch",
    "typecheck": "tsc --noEmit",
    "lint": "biome check",
    "lint:fix": "biome check --write --unsafe",
    "format": "biome format --write",
    "zip": "pnpm build && cd dist && zip -qr ../tab-headers.zip ."
  },
  "devDependencies": {
    "@biomejs/biome": "^2.5.14",
    "@types/chrome": "^0.3.0",
    "esbuild": "^0.28.2",
    "typescript": "^7.0.2"
  },
  "packageManager": "pnpm@11.27.1",
  "engines": {
    "node": ">=20"
  }
}
